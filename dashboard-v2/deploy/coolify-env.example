# Template environment Coolify (JANGAN commit nilai asli).
# Set sebagai Environment Variables di Coolify → resource ujion-dashboard.
# Generate secrets: openssl rand -hex 32  (2x: JWT_SECRET + MASTER_KEY)
#                    openssl rand -base64 24  (OPENCODE_SERVER_PASSWORD)

# Auth
DASHBOARD_PIN=245100
JWT_SECRET=ganti-dengan-openssl-rand-hex-32
MASTER_KEY=ganti-dengan-openssl-rand-hex-32

# opencode (password harus SAMA dengan /etc/opencode-serve.env di host!
# Lihat: sudo cat /etc/opencode-serve.env setelah pasang-opencode-serve.sh)
OPENCODE_SERVER_PASSWORD=sama-dengan-etc-opencode-serve-env

# Host paths (volume mounts — sesuaikan path VPS Anda)
UJION_OPS_HOST_PATH=/root/proyek/ujion-ops
UJION_TKA_APPS_HOST_PATH=/root/proyek/ujion-tka-apps

# Provider API Keys (opsional, bisa juga via dashboard UI /keys)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
