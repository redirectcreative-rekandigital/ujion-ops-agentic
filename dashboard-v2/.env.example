# Dashboard Ujion v2 — template env (COMMITTED)
# Salin ke .env.local untuk dev lokal, atau set sebagai Environment Variables di Coolify.
# JANGAN isi nilai asli di file ini.

# Dashboard Auth
DASHBOARD_PIN=245100
JWT_SECRET=change-this-to-a-random-64-char-string

# Encryption Master Key (API key vault)
# Generate: openssl rand -hex 32
MASTER_KEY=change-this-to-a-random-64-char-string

# opencode Serve
OPENCODE_SERVER_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=change-this-opencode-password

# Workspace Paths — LOKAL (Windows contoh):
# WORKSPACE_PATH=../
# UJION_OPS_PATH=../
# UJION_TKA_APPS_PATH=../../ujion-tka-apps
# DB_PATH=./data/ujion.db

# Workspace Paths — VPS/Coolify (single-container):
WORKSPACE_PATH=/workspace/ujion-ops
UJION_OPS_PATH=/workspace/ujion-ops
UJION_TKA_APPS_PATH=/workspace/ujion-tka-apps
DB_PATH=/data/ujion.db

# Provider API Keys (opsional, bisa juga di-set via dashboard UI /api/keys)
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
